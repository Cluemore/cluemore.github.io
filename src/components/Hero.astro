---
import { profile } from "../data/profile";

const roles = profile.roles.join(" · ");
const words = JSON.stringify(profile.morphWords);
---

<header class="site-header" aria-label="Primary navigation">
  <a class="wordmark" href="#top" aria-label="Shravani Patil, back to top">
    <span>SP</span>
    <span class="wordmark-index">01</span>
  </a>

  <nav class="contact-nav" aria-label="Contact links">
    <a href={profile.github} target="_blank" rel="noreferrer">GitHub</a>
    <a href={profile.linkedin} target="_blank" rel="noreferrer">LinkedIn</a>
    <a href={`mailto:${profile.email}`}>Email</a>
  </nav>
</header>

<section class="hero" id="top" data-hero>
    <div class="hero-meta">
      <p class="section-index">01 / Portfolio</p>
      <p class="role-line">{roles}</p>
    </div>

    <h1 class="hero-name" aria-label={profile.name}>
      <span>Shravani</span>
      <span class="name-last">Patil</span>
    </h1>

    <div class="hero-closing">
      <div class="statement-wrap">
        <p class="hero-statement" aria-hidden="true">
          <span>I turn</span>
          <span class="morph-line">
            <span class="morph-highlight">
              <span data-morph-word data-words={words}>data</span>
            </span>
          </span>
          <span>into things people can use.</span>
        </p>
        <p class="sr-only">
          I turn data, models, and ideas into things people can use.
        </p>
        <button class="motion-toggle" type="button" data-motion-toggle hidden>
          Pause motion
        </button>
      </div>

      <div class="hero-aside">
        <p>
          Building practical systems from questions, evidence, and thoughtful
          communication.
        </p>
        <a class="text-link" href={`mailto:${profile.email}`}>
          Start a conversation
          <span aria-hidden="true">↗</span>
        </a>
      </div>
    </div>

    <svg
      class="signature-line"
      viewBox="0 0 900 150"
      preserveAspectRatio="none"
      aria-hidden="true"
    >
      <path
        pathLength="1"
        d="M2 108C144 110 182 23 322 48c144 26 167 80 305 42 75-20 128-63 271-53"
      />
    </svg>

    <svg
      class="data-orbit"
      viewBox="0 0 160 160"
      role="img"
      aria-label="Abstract connected data points"
      data-orbit
    >
      <circle class="orbit-ring" cx="80" cy="80" r="57" />
      <path class="orbit-path" d="M35 91 74 50l48 22-20 47-67-28Z" />
      <circle class="node node-one" cx="35" cy="91" r="6" />
      <circle class="node node-two" cx="74" cy="50" r="5" />
      <circle class="node node-three" cx="122" cy="72" r="7" />
      <circle class="node node-four" cx="102" cy="119" r="4" />
    </svg>

  <a class="scroll-cue" href="#about">Explore ↓</a>
</section>

<script>
  const hero = document.querySelector<HTMLElement>("[data-hero]");
  const word = document.querySelector<HTMLElement>("[data-morph-word]");
  const toggle = document.querySelector<HTMLButtonElement>("[data-motion-toggle]");
  const orbit = document.querySelector<SVGElement>("[data-orbit]");
  const reducedMotion = window.matchMedia("(prefers-reduced-motion: reduce)");

  if (hero && word && toggle && !reducedMotion.matches) {
    const words = JSON.parse(word.dataset.words ?? "[]") as string[];
    let wordIndex = 0;
    let timer: number | undefined;
    let manuallyPaused = false;
    let heroIsVisible = true;

    toggle.hidden = false;

    const shouldPlay = () =>
      !manuallyPaused && heroIsVisible && document.visibilityState === "visible";

    const schedule = () => {
      window.clearTimeout(timer);
      if (!shouldPlay() || words.length < 2) return;

      timer = window.setTimeout(() => {
        word.classList.add("is-changing");
        window.setTimeout(() => {
          wordIndex = (wordIndex + 1) % words.length;
          word.textContent = words[wordIndex];
          word.classList.remove("is-changing");
          schedule();
        }, 240);
      }, 2400);
    };

    toggle.addEventListener("click", () => {
      manuallyPaused = !manuallyPaused;
      toggle.setAttribute("aria-pressed", String(manuallyPaused));
      toggle.textContent = manuallyPaused ? "Resume motion" : "Pause motion";
      schedule();
    });

    document.addEventListener("visibilitychange", schedule);

    const observer = new IntersectionObserver(
      ([entry]) => {
        heroIsVisible = entry.isIntersecting;
        schedule();
      },
      { threshold: 0.15 },
    );

    observer.observe(hero);
    schedule();
  }

  if (hero && orbit && !reducedMotion.matches) {
    let frame = 0;

    hero.addEventListener("pointermove", (event) => {
      window.cancelAnimationFrame(frame);
      frame = window.requestAnimationFrame(() => {
        const bounds = hero.getBoundingClientRect();
        const x = (event.clientX - bounds.left) / bounds.width - 0.5;
        const y = (event.clientY - bounds.top) / bounds.height - 0.5;
        orbit.style.setProperty("--orbit-x", `${x * 14}px`);
        orbit.style.setProperty("--orbit-y", `${y * 14}px`);
      });
    });

    hero.addEventListener("pointerleave", () => {
      orbit.style.setProperty("--orbit-x", "0px");
      orbit.style.setProperty("--orbit-y", "0px");
    });
  }
</script>
